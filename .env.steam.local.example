# Copy this file to .env.local and fill in your values.

STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password
# Optional: only needed when Steam Guard prompts during scripted login.
STEAM_GUARD_CODE=
# Optional: set if steamcmd is not on PATH.
STEAMCMD_PATH=
# Optional: override the build description shown in Steamworks.
STEAM_BUILD_DESC=
# Optional: override the branch selected by the upload script. Leave blank to use its default.
STEAM_SET_LIVE_BRANCH=
# Optional: set to 1 for a preview upload.
STEAM_PREVIEW=0
