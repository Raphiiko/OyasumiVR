    "material-symbols": "^0.47.4",
    "moment": "^2.31.0",
    "mqtt": "^5.16.0",
    "ngx-moment": "^6.0.2",
    "ngx-pipes": "^3.2.2",
    "p-min-delay": "^4.2.0",
    "rxjs": "^7.8.2",
    "set-cookie-parser": "^3.1.2",
    "src-shared-ts": "file:src-shared-ts",
    "three": "^0.186.0",
