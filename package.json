{
  "name": "oyasumi",
  "version": "26.9.0-beta.14",
  "author": "Raphiiko",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "//1": "=== Development ===",
    "dev": "npm run tauri dev -- -- -- --core-mode dev --overlay-sidecar-mode dev",
    "start": "npm run tauri dev",
    "start:ui": "node scripts/pre-build.js && ng serve oyasumivr",
    "start:overlay": "cd src-overlay-sidecar && dotnet build && dotnet run -- dev",
    "start:overlay-ui": "ng serve overlay-ui",
    "//2": "=== Build ===",
    "//2.1": "build runs the full standalone build (Tauri invokes the sidecar/frontend builds via beforeBuildCommand)",
    "build": "npm run tauri build",
    "build:sidecars": "run-p build:sidecar:elevated build:sidecar:overlay",
    "build:sidecar:elevated": "run-s _build:sidecar:elevated:core _build:sidecar:elevated:post",
    "build:sidecar:overlay": "rimraf src-core/resources/overlay-sidecar && run-p _build:sidecar:overlay:ui _build:sidecar:overlay:core && run-s _build:sidecar:overlay:post",
    "//3": "=== Steam (build / upload / deploy) ===",
    "build:steam:alpha": "npm run build:steam:beta",
    "build:steam:beta": "node scripts/upload-sourcemaps.js --check && npm run clean && npm run _prepare:steam && npm run tauri -- build --no-bundle --debug && npm run _package:steam",
    "build:steam:release": "node scripts/upload-sourcemaps.js --check && npm run clean && npm run _prepare:steam && npm run tauri -- build --no-bundle && npm run _package:steam",
    "upload:steam:alpha": "node scripts/steam/upload-steam-build.js alpha",
    "upload:steam:beta": "node scripts/steam/upload-steam-build.js beta",
    "upload:steam:release": "node scripts/steam/upload-steam-build.js release",
    "deploy:steam:alpha": "npm run build:steam:alpha && npm run upload:steam:alpha && npm run prepare:dev",
    "deploy:steam:beta": "npm run bump:beta && npm run _commit:version-bump && npm run build:steam:beta && npm run upload:steam:beta && npm run prepare:dev",
    "deploy:steam:release": "npm run build:steam:release && npm run upload:steam:release && npm run prepare:dev",
    "//4": "=== State setters ===",
    "bump:beta": "node scripts/bump-version.js beta",
    "bump:release": "node scripts/bump-version.js release",
    "set-version": "node scripts/set-version.js",
    "set-flavour": "node scripts/set-flavour.js",
    "set-build-id": "node scripts/set-build-id.js",
    "prepare:dev": "npm run set-build-id && npm run set-flavour DEV",
    "//5": "=== Tools ===",
    "format": "run-s format:eslint format:prettier",
    "format:eslint": "eslint --no-error-on-unmatched-pattern --fix \"src-ui/**/*.ts\" \"src-overlay-ui/**/*.ts\" \"src-shared-ts/**/*.ts\" \"scripts/**/*.ts\"",
    "format:prettier": "prettier --write \"src-ui/**/*.{html,css,scss,js,ts}\" \"src-overlay-ui/**/*.{html,css,scss,js,ts}\" \"src-shared-ts/**/*.{html,css,scss,js,ts}\" \"scripts/**/*.{html,css,scss,js,ts}\"",
    "lint": "ng lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist && rimraf src-overlay-sidecar/bin && rimraf src-overlay-sidecar/obj && rimraf src-overlay-ui/build && rimraf src-elevated-sidecar/target && rimraf src-privileged-launcher/target && rimraf tools/sign-elevated-sidecar/target && rimraf src-core/target && rimraf src-shared-rust/target && rimraf src-core/resources/elevated-sidecar && rimraf src-core/resources/privileged-launcher && rimraf src-core/resources/overlay-sidecar && rimraf src-core/resources/fonts",
    "tl": "node scripts/translation-utils.js",
    "tl:check-icu": "node scripts/check-icu.mjs",
    "generate:readmes": "node scripts/readme-generator.js",
    "generate:grpc-web-client": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./scripts/ts-proto-gen.ps1 && prettier --loglevel silent --write src-grpc-web-client/**/*",
    "tauri": "tauri",
    "ng": "ng",
    "//6": "=== Setup ===",
    "init": "npm install",
    "ci": "npm ci",
    "//7": "=== Internals (do not invoke directly) ===",
    "//7.1": "_build:pre is invoked by tauri.conf.json beforeBuildCommand",
    "_build:pre": "node scripts/pre-build.js && run-p _build:front build:sidecars",
    "_build:front": "ng build oyasumivr && node scripts/upload-sourcemaps.js",
    "_build:sidecar:elevated:core": "cd src-elevated-sidecar && cargo build --release && cd ..",
    "_build:sidecar:elevated:post": "node scripts/elevated-sidecar-post-build.js",
    "_build:sidecar:overlay:ui": "rimraf src-overlay-ui/build && ng build overlay-ui && node scripts/overlay-ui-post-build.js",
    "_build:sidecar:overlay:core": "cd src-overlay-sidecar && dotnet publish -r win-x64 -c Release && cd ..",
    "_build:sidecar:overlay:post": "node scripts/overlay-sidecar-post-build.js",
    "_prepare:steam": "npm run set-build-id && npm run set-flavour STEAM",
    "_package:steam": "node scripts/steam/package-steam-build.js STEAM && node scripts/steam/package-steam-build.js STEAM_CN && node scripts/steam/archive-symbols.js",
    "_commit:version-bump": "node scripts/commit-version-bump.js",
    "check": "node scripts/checks.mjs all",
    "check:quick": "node scripts/checks.mjs quick",
    "check:format:web": "node scripts/checks.mjs format:web",
    "check:lint:web": "node scripts/checks.mjs lint:web",
    "check:test:web": "node scripts/checks.mjs test:web",
    "check:translations": "node scripts/checks.mjs translations",
    "check:generated:readmes": "node scripts/checks.mjs generated:readmes",
    "check:build:ui": "node scripts/checks.mjs build:ui",
    "check:build:overlay-ui": "node scripts/checks.mjs build:overlay-ui",
    "check:format:csharp": "node scripts/checks.mjs format:csharp",
    "check:build:overlay-sidecar": "node scripts/checks.mjs build:overlay-sidecar",
    "check:format:core": "node scripts/checks.mjs format:core",
    "check:lint:core": "node scripts/checks.mjs lint:core",
    "check:test:core": "node scripts/checks.mjs test:core",
    "check:build:core": "node scripts/checks.mjs build:core",
    "check:format:shared-rust": "node scripts/checks.mjs format:shared-rust",
    "check:lint:shared-rust": "node scripts/checks.mjs lint:shared-rust",
    "check:test:shared-rust": "node scripts/checks.mjs test:shared-rust",
    "check:build:shared-rust": "node scripts/checks.mjs build:shared-rust",
    "check:format:elevated-sidecar": "node scripts/checks.mjs format:elevated-sidecar",
    "check:lint:elevated-sidecar": "node scripts/checks.mjs lint:elevated-sidecar",
    "check:test:elevated-sidecar": "node scripts/checks.mjs test:elevated-sidecar",
    "check:build:elevated-sidecar": "node scripts/checks.mjs build:elevated-sidecar",
    "check:format:privileged-launcher": "node scripts/checks.mjs format:privileged-launcher",
    "check:lint:privileged-launcher": "node scripts/checks.mjs lint:privileged-launcher",
    "check:test:privileged-launcher": "node scripts/checks.mjs test:privileged-launcher",
    "check:build:privileged-launcher": "node scripts/checks.mjs build:privileged-launcher",
    "check:format:memory-watch": "node scripts/checks.mjs format:memory-watch",
    "check:lint:memory-watch": "node scripts/checks.mjs lint:memory-watch",
    "check:test:memory-watch": "node scripts/checks.mjs test:memory-watch",
    "check:build:memory-watch": "node scripts/checks.mjs build:memory-watch",
    "check:format:signing-tool": "node scripts/checks.mjs format:signing-tool",
    "check:lint:signing-tool": "node scripts/checks.mjs lint:signing-tool",
    "check:test:signing-tool": "node scripts/checks.mjs test:signing-tool",
    "check:build:signing-tool": "node scripts/checks.mjs build:signing-tool",
    "check:format": "node scripts/checks.mjs format",
    "check:lint": "node scripts/checks.mjs lint",
    "check:test": "node scripts/checks.mjs test",
    "check:build": "node scripts/checks.mjs build",
    "check:generated": "node scripts/checks.mjs generated",
    "check:format:rust": "node scripts/checks.mjs format:rust",
    "check:lint:rust": "node scripts/checks.mjs lint:rust",
    "check:test:rust": "node scripts/checks.mjs test:rust",
    "check:build:rust": "node scripts/checks.mjs build:rust"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.1.7",
    "@angular/common": "~22.1.7",
    "@angular/compiler": "~22.1.7",
    "@angular/core": "~22.1.7",
    "@angular/forms": "~22.1.7",
    "@angular/platform-browser": "~22.1.7",
    "@angular/router": "~22.1.7",
    "@aptabase/tauri": "github:aptabase/tauri-plugin-aptabase",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@sentry/angular": "^10.75.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.6.1",
