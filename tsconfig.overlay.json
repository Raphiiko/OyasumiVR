{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/overlay",
    "types": []
  },
  "files": ["src-overlay-ui/main.ts"],
  "include": ["src-overlay-ui/**/*.d.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
